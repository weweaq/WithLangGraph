LLM_PROVIDER=deepseek

# --- LLM_PROVIDER=openai (OpenAI 或 OpenAI 兼容网关) ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LLM_PROVIDER=deepseek (OpenAI 兼容协议, 默认 https://api.deepseek.com/v1) ---
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-v4-pro

DEFAULT_MAX_TURNS=40

# --- QQ Bot (gacore.frontends.qq) ---
QQ_APP_ID=
QQ_APP_SECRET=
QQ_ALLOWED_USERS=*
QQ_ADMIN_USERS=           # 逗号分隔 openid，可触发 /reboot；* = 白名单内全部用户；留空 = 无人可重启
QQ_LOG_FILE=logs/qq.log
