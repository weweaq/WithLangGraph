LLM_PROVIDER=deepseek

# --- LLM_PROVIDER=openai (OpenAI 或 OpenAI 兼容网关) ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# --- LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxx
